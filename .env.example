# Copia este archivo a .env y rellena tus valores.
#   cp .env.example .env
# .env está gitignored: NUNCA subas claves reales al repositorio.

# ─── ROUTER DE INTENTS (100 % LOCAL) ────────────────────────────────────────
# Sin proveedor cloud: Groq se eliminó el 2026-10-28 (latencia y privacidad).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
# 2048 trunca el prompt (~1900 tokens) y hunde el acierto al 28 %: no bajarlo.
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m

# ─── ASISTENTE POR OBJETIVOS (LangGraph local; activación gradual) ──────────
# false conserva el pipeline anterior. Ver docs/tasks/mejora-1-asistente-por-objetivos.md
AGENT_ENABLED=false
AGENT_TASK_PATH=~/.limits/tareas
# OpenCode primero; respaldo NVIDIA específico para cada rol, sin alternancia.
AGENT_REMOTE_PROVIDER=opencode_con_respaldo
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEVELOPMENT_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_ANALYSIS_MODEL=nvidia/nemotron-3.5-bolt-e4b
# GLM tiene credencial independiente; habilitarlo solo tras comprobar respuesta útil.
NVIDIA_GLM_API_KEY=
NVIDIA_GLM_MODEL=z-ai/glm-5.3-flash
AGENT_GLM_FALLBACK=false
# Análisis: Big Pickle primero, Super y Bolt después, con claves independientes.
NVIDIA_SUPER_API_KEY=
NVIDIA_SUPER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BOLT_API_KEY=
AGENT_SUPER_FALLBACK=false
# Groq es respaldo de especialistas; el router de órdenes permanece local.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=2048
AGENT_GROQ_FALLBACK=false
NVIDIA_MAX_TOKENS=4096
NVIDIA_THINKING_ENABLED=true
NVIDIA_MODEL_COOLDOWN=60
# Modelos principales de OpenCode (también usados con opencode_con_respaldo).
AGENT_OPENCODE_BIN=opencode
# Los modelos gratuitos pueden devolver 429. Vacío desactiva ese especialista.
AGENT_DEVELOPMENT_MODEL=opencode/deepseek-v4.1-flash-free
AGENT_ANALYSIS_MODEL=opencode/big-pickle
AGENT_MAX_STEPS=6
AGENT_TIMEOUT=120
AGENT_CONTEXT_CHARS=12000
AGENT_VOICE_CHARS=900
AGENT_APPROVAL_TTL=300

# ─── SPEECH TO TEXT ─────────────────────────────────────────────────────────
# Modelo Whisper: tiny | base | small (recomendado) | medium
WHISPER_MODEL=small
# Idioma: es (español), en (inglés), None (autodetect)
LANGUAGE=es
# Dispositivo: cpu o cuda (GPU NVIDIA)
STT_DEVICE=cpu

# ─── TEXT TO SPEECH ─────────────────────────────────────────────────────────
PIPER_VOICE_MODEL=~/.local/share/piper/es_ES-davefx-medium.onnx
# Velocidad de la voz (0.8 = más lento, 1.5 = más rápido)
VOICE_SPEED=1.0
# ID de hablante para voces multi-speaker (0, 1, ...). Vacío para voces single-speaker
VOICE_SPEAKER=

# ─── COMPORTAMIENTO ─────────────────────────────────────────────────────────
# Palabra de activación. Vacío = siempre activo.
# Variaciones separadas por coma (Whisper puede transcribir el nombre de formas distintas)
WAKE_WORD=Limits
RESPONSE_LANGUAGE=es
# Zona horaria para {now} en el prompt. Vacío = la del sistema.
# Ej: America/Costa_Rica, Europe/Madrid
TIMEZONE=

# ─── BARGE-IN (interrumpir al asistente hablando; P0-4) ─────────────────────
# Mientras Limits habla, escucha con VAD: voz sostenida > BARGEIN_MIN_MS corta
# el audio. Palabras que solo cortan (sin ejecutar nada): separadas por coma.
BARGEIN_ENABLED=true
BARGEIN_KEYWORDS=para,cállate,callate,stop,basta,silencio
BARGEIN_MIN_MS=350

# ─── VOZ NATURAL (ElevenLabs — solo respuestas largas; opt-in) ──────────────
# Voz dual: respuestas cortas del sistema siguen con Piper (local); las largas
# (letras, resúmenes web >= MIN_CHARS, futuro puente Gemini) usan ElevenLabs.
# La cuota free es ~10k caracteres/mes: cache y tope por turno la protegen.
# Detalles: docs/plan-elevenlabs-tts.md
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_MODE=auto                # auto (por longitud) | gemini | off
ELEVENLABS_MIN_CHARS=200
ELEVENLABS_MAX_TURN_CHARS=1200
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_CACHE=true

# ─── GATEWAY MOVIL (control remoto por voz desde Android; opt-in) ───────────
# El texto del móvil entra al MISMO pipeline (LLM router → executor).
# Token de pairing autogenerado en ~/.limits/gateway_token al primer arranque.
# Docs: docs/plan-control-remoto-android.md
GATEWAY_ENABLED=false
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8765
GATEWAY_MDNS_NAME=Limits
# ¿El PC sigue hablando las respuestas mientras se controla desde el móvil?
GATEWAY_SPEAK_LOCAL=true
# Ruta alternativa del token (vacío = ~/.limits/gateway_token)
GATEWAY_TOKEN_PATH=
# Mostrar el QR de emparejamiento al arrancar (requiere `qrencode`).
# La app lo escanea una vez: no hay que teclear el token de 64 caracteres.
# Reimprimir en cualquier momento: ./bin/limits-qr [--rotate]
GATEWAY_SHOW_QR=true

# ─── MEMORIA PERSISTENTE (P0-3) ─────────────────────────────────────────────
# SQLite local: hechos («recuerda que X es Y»), notas y episodios. Si la
# desactivas, Limits funciona como antes (sin memoria). Borrar el archivo es
# seguro: se recrea vacío.
MEMORY_ENABLED=true
MEMORY_PATH=~/.limits/memory.db
# Tope del bloque {memory} que entra en el prompt (bytes)
MEMORY_CONTEXT_BYTES=600
# (fase 2) export unidireccional a Obsidian; vacío = desactivado
MEMORY_EXPORT_PATH=

# ─── CEREBRO CONVERSACIONAL (Gemini vía CLI gemdev) ─────────────────────────
# Charla/opiniones e investigación web. La salida va SOLO a voz, jamás al
# executor. Palabras clave que activan la ruta: "investiga", "infórmame",
# "busca en internet", o empezar la frase con "gemini".
# Requiere sesión activa: gemdev login (una vez). Docs: docs/integracion-gemini.md
GEMINI_ENABLED=false
GEMINI_BIN=~/.local/bin/gemdev
GEMINI_TIMEOUT=120
GEMINI_SESSION=~/.limits/gemini_session.json
# Research por debajo de N chars → "No pude investigar ahora…" (fail-loud)
GEMINI_MIN_RESEARCH_CHARS=200
# Voz progresiva con gemdev actualizado (--events); false conserva espera clásica.
GEMINI_STREAMING=true
# Solo se usa cuando GEMINI_STREAMING=false: modo clásico para investigación.
GEMINI_RESEARCH_DAEMON=false

# ─── LANE COMPUESTO (OpenCode DeepSeek → respaldo NVIDIA DeepSeek) ────────
# Nemotron se reserva para respaldo de Big Pickle. Router = OLLAMA_MODEL (1.5b).
# Docs: docs/asistente-por-objetivos.md.
DESKTOP_AGENT_PROVIDER=opencode
DESKTOP_AGENT_FALLBACK=nvidia
DESKTOP_AGENT_MODEL=qwen2.5:3b-instruct
DESKTOP_AGENT_MAX_STEPS=6
# Si vacío, Limits intenta ~/.local/share/opencode/auth.json (provider opencode)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_AGENT_MODEL=opencode/deepseek-v4.1-flash-free

# ─── BÚSQUEDA DE ARCHIVOS (foco Hyprland + muéstramelo) ─────────────────────
# Raíces separadas por ':' (si el intent no trae path). No uses solo ~ (muy lento/ruidoso).
FILE_SEARCH_ROOT=~/Proyectos:~/Escritorio:~/Desktop:~/Descargas:~/Downloads:~/Documentos:~/Documents
# Excludes fd/find (coma)
FILE_SEARCH_EXCLUDES=.git,node_modules,__pycache__,limits-env,site-packages,.venv,venv,.cache
# Espera antes de intentar hyprctl focus tras xdg-open/thunar
FILE_FOCUS_DELAY_S=0.55

# Conversación: ventana para responder sin wake word tras una pregunta (0 desactiva).
DIALOGUE_FOLLOWUP_SECONDS=10
# Vacío usa OLLAMA_MODEL; no cambia el modelo del selector local.
AGENT_CONVERSATION_MODEL=
# Ruta opcional de log; las pruebas usan rutas temporales.
LIMITS_LOG_PATH=logs/limits.log

# Presencia nativa (requiere Quickshell; activar el servicio con ./setup-widget.sh).
PRESENCE_ENABLED=false
PRESENCE_SIZE=172
PRESENCE_MARGIN_TOP=76
PRESENCE_MARGIN_RIGHT=18
PRESENCE_OPACITY=0.95
PRESENCE_REDUCED_MOTION=false
# Vacío fija el monitor enfocado al comenzar el turno.
PRESENCE_MONITOR=

# Raíces autorizadas para resolver proyectos por nombre (separadas por :).
PROJECT_ROOTS=~/Proyectos:~/Work:~/Projects:~/Trabajo:~/Repos

# Agente general por significado; conserva rutas mecánicas como atajos.
AGENT_SEMANTIC=false
AGENT_COGNITIVE_PROVIDER=ollama  # ollama o groq para objetivos flexibles
AGENT_COGNITIVE_FALLBACK_MODEL=openai/gpt-oss-20b
AGENT_ESCALATE=true
AGENT_LOCAL_READ_TIMEOUT=20
GROQ_REASONING_EFFORT=low
# Misma SQLite; carpeta editable como bóveda propia de Obsidian.
KNOWLEDGE_ENABLED=false
KNOWLEDGE_VAULT=~/Documentos/Limits-Memoria

# Ciclo cotidiano único (requiere AGENT_ENABLED y AGENT_SEMANTIC).
# false permite volver al recorrido semántico anterior.
AGENT_COHERENT=false
