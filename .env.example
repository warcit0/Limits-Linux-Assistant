# Copia este archivo a .env y rellena tus valores.
#   cp .env.example .env
# .env está gitignored: NUNCA subas claves reales al repositorio.

# ─── LLM CLOUD (PRIORITARIO / MODO TURBO) ──────────────────────────────────
# Groq API — oficial, gratuita, extremadamente rápida.
# Obtén tu key en: https://console.groq.com (gratis, sin tarjeta)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
# Prioridad del router LLM: local (Ollama primero, Groq fallback) o cloud
LLM_PRIORITY=cloud
# Ajustes Ollama local (VRAM/latencia)
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=30m

# ─── LLM LOCAL (FALLBACK OFFLINE) ───────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ─── SPEECH TO TEXT ─────────────────────────────────────────────────────────
# Modelo Whisper: tiny | base | small (recomendado) | medium
WHISPER_MODEL=small
# Idioma: es (español), en (inglés), None (autodetect)
LANGUAGE=es
# Dispositivo: cpu o cuda (GPU NVIDIA)
STT_DEVICE=cpu

# ─── TEXT TO SPEECH ─────────────────────────────────────────────────────────
PIPER_VOICE_MODEL=~/.local/share/piper/es_ES-davefx-medium.onnx
# Velocidad de la voz (0.8 = más lento, 1.5 = más rápido)
VOICE_SPEED=1.0
# ID de hablante para voces multi-speaker (0, 1, ...). Vacío para voces single-speaker
VOICE_SPEAKER=

# ─── COMPORTAMIENTO ─────────────────────────────────────────────────────────
# Palabra de activación. Vacío = siempre activo.
# Variaciones separadas por coma (Whisper puede transcribir el nombre de formas distintas)
WAKE_WORD=Limits
RESPONSE_LANGUAGE=es
# Zona horaria para {now} en el prompt. Vacío = la del sistema.
# Ej: America/Costa_Rica, Europe/Madrid
TIMEZONE=

# ─── BARGE-IN (interrumpir al asistente hablando; P0-4) ─────────────────────
# Mientras Limits habla, escucha con VAD: voz sostenida > BARGEIN_MIN_MS corta
# el audio. Palabras que solo cortan (sin ejecutar nada): separadas por coma.
BARGEIN_ENABLED=true
BARGEIN_KEYWORDS=para,cállate,callate,stop,basta,silencio
BARGEIN_MIN_MS=350

# ─── VOZ NATURAL (ElevenLabs — solo respuestas largas; opt-in) ──────────────
# Voz dual: respuestas cortas del sistema siguen con Piper (local); las largas
# (letras, resúmenes web >= MIN_CHARS, futuro puente Gemini) usan ElevenLabs.
# La cuota free es ~10k caracteres/mes: cache y tope por turno la protegen.
# Detalles: docs/plan-elevenlabs-tts.md
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_MODE=auto                # auto (por longitud) | gemini | off
ELEVENLABS_MIN_CHARS=200
ELEVENLABS_MAX_TURN_CHARS=1200
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_CACHE=true

# ─── GATEWAY MOVIL (control remoto por voz desde Android; opt-in) ───────────
# El texto del móvil entra al MISMO pipeline (LLM router → executor).
# Token de pairing autogenerado en ~/.limits/gateway_token al primer arranque.
# Docs: docs/plan-control-remoto-android.md
GATEWAY_ENABLED=false
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8765
GATEWAY_MDNS_NAME=Limits
# ¿El PC sigue hablando las respuestas mientras se controla desde el móvil?
GATEWAY_SPEAK_LOCAL=true
# Ruta alternativa del token (vacío = ~/.limits/gateway_token)
GATEWAY_TOKEN_PATH=
# Mostrar el QR de emparejamiento al arrancar (requiere `qrencode`).
# La app lo escanea una vez: no hay que teclear el token de 64 caracteres.
# Reimprimir en cualquier momento: ./bin/limits-qr [--rotate]
GATEWAY_SHOW_QR=true

# ─── MEMORIA PERSISTENTE (P0-3) ─────────────────────────────────────────────
# SQLite local: hechos («recuerda que X es Y»), notas y episodios. Si la
# desactivas, Limits funciona como antes (sin memoria). Borrar el archivo es
# seguro: se recrea vacío.
MEMORY_ENABLED=true
MEMORY_PATH=~/.limits/memory.db
# Tope del bloque {memory} que entra en el prompt (bytes)
MEMORY_CONTEXT_BYTES=600
# (fase 2) export unidireccional a Obsidian; vacío = desactivado
MEMORY_EXPORT_PATH=

# ─── CEREBRO CONVERSACIONAL (Gemini vía CLI gemdev) ─────────────────────────
# Charla/opiniones e investigación web. La salida va SOLO a voz, jamás al
# executor. Palabras clave que activan la ruta: "investiga", "infórmame",
# "busca en internet", o empezar la frase con "gemini".
# Requiere sesión activa: gemdev login (una vez). Docs: docs/integracion-gemini.md
GEMINI_ENABLED=false
GEMINI_BIN=~/.local/bin/gemdev
GEMINI_TIMEOUT=120
GEMINI_SESSION=~/.limits/gemini_session.json
# Research por debajo de N chars → "No pude investigar ahora…" (fail-loud)
GEMINI_MIN_RESEARCH_CHARS=200

# ─── LANE COMPUESTO (desktop_task → OpenCode Agent + fallback Ollama) ───────
# Router de intents = OLLAMA_MODEL (1.5b). Agent ≠ Groq ≠ Big Pickle.
# Docs: docs/plan-desktop-task-calidad.md
DESKTOP_AGENT_PROVIDER=opencode
DESKTOP_AGENT_FALLBACK=ollama
DESKTOP_AGENT_MODEL=qwen2.5:3b-instruct
DESKTOP_AGENT_MAX_STEPS=6
# Si vacío, Limits intenta ~/.local/share/opencode/auth.json (provider opencode)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_AGENT_MODEL=opencode/deepseek-v4.1-flash-free

# ─── BÚSQUEDA DE ARCHIVOS (foco Hyprland + muéstramelo) ─────────────────────
# Raíces separadas por ':' (si el intent no trae path). No uses solo ~ (muy lento/ruidoso).
FILE_SEARCH_ROOT=~/Proyectos:~/Escritorio:~/Desktop:~/Descargas:~/Downloads:~/Documentos:~/Documents
# Excludes fd/find (coma)
FILE_SEARCH_EXCLUDES=.git,node_modules,__pycache__,limits-env,site-packages,.venv,venv,.cache
# Espera antes de intentar hyprctl focus tras xdg-open/thunar
FILE_FOCUS_DELAY_S=0.55
